# Default deny: only reviewed application sources and synthetic tests are tracked.
/*
!/.gitignore
!/.gitattributes
!/baseline/
/baseline/*
!/baseline/v18-original.html
!/baseline/README.md
!/web/
/web/*
!/web/index.html
!/web/css/
/web/css/*
!/web/css/app.css
!/web/js/
/web/js/*
!/web/js/v18-core.js
!/web/js/v18-dataset.js
!/web/js/v18-extensions.js
!/web/js/compatibility.js
!/web/js/data-compatibility.js
!/web/js/model-sources.js
!/web/licenses/
/web/licenses/*
!/web/licenses/onnxruntime-MIT.txt
!/web/licenses/onnxruntime-ThirdPartyNotices.txt
!/web/js/tag-catalog.js
!/scripts/
/scripts/*
!/scripts/build.mjs
!/scripts/serve.mjs
!/scripts/audit-release.mjs
!/tests/
/tests/*
!/tests/migration.test.mjs
!/tests/browser.test.mjs
!/tests/data-compatibility.test.mjs
!/tests/runtime.test.mjs
!/tests/release.test.mjs
!/docs/
/docs/*
!/docs/COMPATIBILITY.md
!/docs/TESTING.md
!/docs/PUBLISHING.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml
!/README.md
!/package.json
!/package-lock.json
!/playwright.config.mjs
# Original data, model binaries, dependencies, reports and dist are never staged.
